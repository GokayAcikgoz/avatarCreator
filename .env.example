# Copy to `.env` and fill in. `.env` is git-ignored — never commit real values.
#
# Who reads what:
#   - Next.js (npm run dev / build) reads this file itself. Only NEXT_PUBLIC_* variables reach the
#     browser bundle; everything else stays server-side.
#   - The API and its tests read it through scripts/with-env.mjs (npm run api / npm run test:api).

# --- Web ---------------------------------------------------------------------------------------
# Where the browser reaches the AvatarForge API (ASP.NET Core). Default: http://localhost:5080
NEXT_PUBLIC_AVATARFORGE_API_URL=http://localhost:5080

# Dev-only: load the asset catalog from the API instead of the bundled shared/asset-catalog.json.
# The key is readable in client-side JS — never put a real/production key here.
# NEXT_PUBLIC_USE_REMOTE_ASSETS=true
# NEXT_PUBLIC_AVATARFORGE_API_KEY=af_live_replace_with_a_dev_key

# --- API -----------------------------------------------------------------------------------------
# PostgreSQL connection for the API. (Alternatively keep it in `dotnet user-secrets` as
# ConnectionStrings:Default — an environment variable wins over user-secrets.)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=avatarforge_dev;Username=postgres;Password=change_me

# Separate database for the integration tests (they create and migrate it themselves).
AVATARFORGE_TEST_DB_CONNECTION=Host=localhost;Port=5432;Database=avatarforge_test;Username=postgres;Password=change_me

# Production only: comma-separated origins allowed to call the API with credentials.
# API_ALLOWED_ORIGINS=https://app.example.com
