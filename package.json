{
  "name": "avatarforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-mediapipe.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-mediapipe.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "api": "node scripts/with-env.mjs dotnet run --project api/src/AvatarForge.Api --launch-profile http",
    "test:api": "node scripts/with-env.mjs dotnet test api/AvatarForge.sln",
    "assets:server": "node tools/asset-pipeline/build_server_assets.mjs",
    "assets:clips": "node tools/asset-pipeline/build_animation_clips.mjs",
    "assets:facial-hair": "python tools/asset-pipeline/generate_facial_hair_textures.py && node tools/asset-pipeline/generate_facial_hair.mjs",
    "assets:postprocess": "node tools/asset-pipeline/postprocess_attachments.mjs",
    "assets:thumbnails": "node tools/asset-pipeline/render_thumbnails.mjs",
    "assets:face-calibration": "node tools/asset-pipeline/calibrate_face_metrics.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.17",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.55.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
